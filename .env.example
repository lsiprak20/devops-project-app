# =============================================================================
# Secure Event Ticketing Platform - primjer environment varijabli
# Autor: Lovro Siprak
# -----------------------------------------------------------------------------
# KAKO KORISTITI:
#   1) Kopiraj ovu datoteku u ".env"   ->   cp .env.example .env
#   2) Promijeni barem POSTGRES_PASSWORD na nesto svoje.
#   3) .env se NE commita u git (vidi .gitignore). Ovdje su samo lokalne tajne.
# =============================================================================

# --- PostgreSQL baza ---
POSTGRES_DB=ticketing
POSTGRES_USER=ticketing_user
POSTGRES_PASSWORD=change_me_local
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis (queue/cache) ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Aplikacijski portovi ---
API_PORT=8080
FRONTEND_PORT=3000

# URL preko kojeg frontend (browser korisnika) zove API.
# Lokalno preko Compose-a API je dostupan na hostu na portu 8080.
API_BASE_URL=http://localhost:8080

# --- Queue / runtime ---
QUEUE_NAME=ticket_orders
NODE_ENV=development
